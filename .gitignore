# Tangkapan layar bukti QA: sumber lokal, TIDAK dipush.
# Gambarnya tertanam di dalam docs/qa/report/*.pdf yang justru dipush,
# jadi bukti visualnya tetap ikut ke repositori lewat laporan jadinya.
/docs/qa/evidence/

# Artefak latihan migrasi (dump produksi, log) — jangan pernah masuk git
/storage/latihan/

# Python bytecode from QA skill scripts
__pycache__/
*.pyc

# Hasil render video Remotion (npm run video:render)
/out/
